APP_NAME="Demo Hastane"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost:8090
APP_LOCALE=tr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hastane
DB_USERNAME=hastane
DB_PASSWORD=hastane

CACHE_STORE=array
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# === Dowaba Laravel Bridge ===
# Bu demo'yu gerçek WhatsApp template gönderir hale getirmek için:
# 1. https://dowaba.com'a kaydol, admin panelinde bir Site oluştur
# 2. /admin/oauth/clients → yeni OAuth client (redirect_uri = http://localhost:8090/dowaba/auth/callback)
# 3. Aşağıdaki değerleri doldur

DOWABA_URL=https://dowaba.com
DOWABA_CLIENT_ID=
DOWABA_CLIENT_SECRET=
DOWABA_REDIRECT_URI="${APP_URL}/dowaba/auth/callback"
DOWABA_SCOPES="openid profile email dowaba.whatsapp.send offline_access"
DOWABA_WIDGET_SITE_ID=
DOWABA_WIDGET_SECRET=
DOWABA_TOKEN_STORE=database
