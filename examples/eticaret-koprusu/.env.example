APP_NAME="Demo Mağaza"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost:8092
APP_LOCALE=tr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eticaret
DB_USERNAME=eticaret
DB_PASSWORD=eticaret

CACHE_STORE=array
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# === Dowaba Laravel Bridge ===
# Bu demo'yu gerçek WhatsApp template gönderir hale getirmek için:
# 1. https://dowaba.com'a kaydol, admin panelinde bir Site oluştur
# 2. /admin/oauth/clients → yeni OAuth client (redirect_uri = http://localhost:8092/dowaba/auth/callback)
# 3. WhatsApp template'leri Dowaba admin'de tanımla:
#    - order_placed          (name, order_number, item_count, total)
#    - order_paid            (name, order_number, total)
#    - order_shipped         (name, order_number, tracking_code)
#    - order_delivered       (name, order_number)
#    - order_cancelled       (name, order_number)
#    - order_delivery_check  (name, order_number, tracking_code, days_shipped)

DOWABA_URL=https://dowaba.com
DOWABA_CLIENT_ID=
DOWABA_CLIENT_SECRET=
DOWABA_REDIRECT_URI="${APP_URL}/dowaba/auth/callback"
DOWABA_SCOPES="openid profile email dowaba.whatsapp.send offline_access"
DOWABA_WIDGET_SITE_ID=
DOWABA_WIDGET_SECRET=
DOWABA_TOKEN_STORE=database
