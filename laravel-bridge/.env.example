# Dowaba Laravel Bridge — environment örneği
# composer require dowaba/laravel-bridge'den sonra projenizin .env dosyasına ekleyin

# Dowaba SaaS URL (bayi white-label domain de olabilir)
DOWABA_URL=https://dowaba.com

# OAuth client (Dowaba admin → /admin/oauth/clients → Yeni Client)
DOWABA_CLIENT_ID=dosc_xxxxxxxxxxxxxxxx
DOWABA_CLIENT_SECRET=dosec_xxxxxxxxxxxxxxxx

# Callback URL — Dowaba client kayıtındaki redirect_uri ile birebir aynı olmalı
DOWABA_REDIRECT_URI="${APP_URL}/dowaba/auth/callback"

# OAuth scope'lar (boşlukla ayrılmış)
# MVP: openid profile email offline_access
# Genişletilmiş: + dowaba.sites.read dowaba.conversations.read dowaba.whatsapp.send dowaba.contacts.write
DOWABA_SCOPES="openid profile email offline_access"

# Widget embed (HMAC-signed user token üretimi için)
DOWABA_WIDGET_SITE_ID=
DOWABA_WIDGET_SECRET=
DOWABA_WIDGET_TOKEN_TTL=300

# HTTP timeouts (saniye)
DOWABA_HTTP_TIMEOUT=10
DOWABA_HTTP_CONNECT_TIMEOUT=3
DOWABA_HTTP_RETRIES=2

# Token store (database = dowaba_oauth_tokens tablosu, cache = Laravel cache)
DOWABA_TOKEN_STORE=database

# JWKS cache TTL (saniye)
DOWABA_JWKS_CACHE_TTL=3600

# Route prefix (çakışma varsa değiştir)
DOWABA_ROUTE_PREFIX=dowaba
