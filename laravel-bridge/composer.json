{
    "name": "dowaba/laravel-bridge",
    "description": "Laravel paketi — Dowaba SaaS (AI iletişim platformu) ile kendi panelinizden konuşmaları yönetin, WhatsApp/Mail/Instagram/Telegram/SIP gönderin, hazır Blade component'leri kullanın.",
    "type": "library",
    "keywords": [
        "laravel",
        "dowaba",
        "whatsapp",
        "mail",
        "instagram",
        "telegram",
        "sip",
        "voice",
        "oauth",
        "sdk",
        "ai",
        "chatbot",
        "destek-ai"
    ],
    "homepage": "https://dowaba.com/api-docs-ornekler",
    "license": "MIT",
    "authors": [
        {
            "name": "Aydın Acar",
            "email": "destek@dowaba.com",
            "homepage": "https://dowaba.com"
        }
    ],
    "support": {
        "issues": "https://github.com/rdtvaacar/dowaba-plugins/issues",
        "source": "https://github.com/rdtvaacar/dowaba-plugins/tree/main/laravel-bridge",
        "docs": "https://dowaba.com/api-docs"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "mockery/mockery": "^1.6",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^1.11",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Dowaba\\LaravelBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dowaba\\LaravelBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dowaba\\LaravelBridge\\DowabaBridgeServiceProvider"
            ],
            "aliases": {
                "Dowaba": "Dowaba\\LaravelBridge\\Facades\\Dowaba"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage --coverage-html=build/coverage",
        "phpstan": "vendor/bin/phpstan analyse --level=6 src",
        "pint": "vendor/bin/pint --test",
        "pint:fix": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
