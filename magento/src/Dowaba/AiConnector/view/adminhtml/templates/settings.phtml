        <button type="button" class="action-default" id="dwb-audit-refresh"><?= $escaper->escapeHtml(__('Load recent calls')) ?></button>
        <div id="dwb-audit-result" class="dwb-audit-result"></div>
    </section>
</div>

<script>
(function () {
    'use strict';
    var root = document.getElementById('dwb-wizard');
    if (!root) { return; }

    var regenerateUrl = root.getAttribute('data-regenerate-url');
    var testUrl = root.getAttribute('data-test-url');
    var auditUrl = root.getAttribute('data-audit-url');

    function copyToClipboard(selector) {
        var el = document.querySelector(selector);
        if (!el) { return; }
        el.select();
        try { document.execCommand('copy'); } catch (e) {}
        if (navigator.clipboard) { navigator.clipboard.writeText(el.value).catch(function () {}); }
    }

    document.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () { copyToClipboard(btn.getAttribute('data-copy')); });
    });

    // --- Regenerate key
    var regen = document.getElementById('dwb-regenerate');
    if (regen) {
        regen.addEventListener('click', function () {
            regen.disabled = true;
            fetch(regenerateUrl, { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    regen.disabled = false;
                    if (data && data.success) {
                        var box = document.getElementById('dwb-key-result');
                        document.getElementById('dwb-plain-key').value = data.plain_key;
                        box.style.display = 'block';
                    } else {
                        alert((data && data.error) || 'Error');
                    }
                })
                .catch(function () { regen.disabled = false; alert('Request failed'); });
        });
    }

    // --- Test connection
    var test = document.getElementById('dwb-test');
    if (test) {
        test.addEventListener('click', function () {
            var out = document.getElementById('dwb-test-result');
            test.disabled = true;
            out.style.display = 'block';
            out.className = 'dwb-test-result';
            out.textContent = '…';
            fetch(testUrl, { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    test.disabled = false;
                    if (data && data.success) {
                        out.classList.add('dwb-ok');
                        out.innerHTML = '✅ schema ' + data.schema_version + ' · ' + data.function_count + ' functions<br><small>' + data.url + '</small>';
                    } else {
                        out.classList.add('dwb-bad');
                        out.innerHTML = '❌ ' + ((data && data.error) || 'Error') + '<br><small>' + ((data && data.url) || '') + '</small>';
                    }
                })
                .catch(function () { test.disabled = false; out.classList.add('dwb-bad'); out.textContent = 'Request failed'; });
        });
    }

    // --- Audit log
    var auditBtn = document.getElementById('dwb-audit-refresh');
    if (auditBtn) {
        auditBtn.addEventListener('click', function () {
            var out = document.getElementById('dwb-audit-result');
            auditBtn.disabled = true;
            out.innerHTML = '<p>…</p>';
            fetch(auditUrl + '?limit=50', { method: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    auditBtn.disabled = false;
                    if (!data || !data.success) { out.innerHTML = '<p class="dwb-bad">Error</p>'; return; }
                    if (!data.rows.length) { out.innerHTML = '<p class="dwb-muted">No calls yet.</p>'; return; }
                    var html = '<table class="dwb-table"><thead><tr><th>Function</th><th>IP</th><th>Status</th><th>ms</th><th>When</th></tr></thead><tbody>';
                    data.rows.forEach(function (row) {
                        var cls = row.status_code >= 400 ? 'dwb-bad' : 'dwb-ok';
                        html += '<tr><td>' + esc(row.function_slug) + '</td><td>' + esc(row.request_ip) + '</td><td class="' + cls + '">' + row.status_code + '</td><td>' + row.duration_ms + '</td><td>' + esc(row.created_at) + '</td></tr>';
                    });
                    html += '</tbody></table>';
                    out.innerHTML = html;
                })
                .catch(function () { auditBtn.disabled = false; out.innerHTML = '<p class="dwb-bad">Request failed</p>'; });
        });
    }

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
})();
</script>
